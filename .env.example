# ============================================================
# USDC-to-BDT Payment Gateway — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ============================================================
# Turso (libSQL) — Required
# Get from: https://turso.tech → your database → connect
# ============================================================
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ============================================================
# JWT Secrets — Required
# Generate each with: openssl rand -hex 32
# ============================================================
# Signs merchant session tokens (8h expiry)
JWT_SECRET=change-me-32-chars-minimum

# ============================================================
# Blockchain — Arc Mainnet
# ============================================================
# Deployed USDCPaymentGateway contract address on Arc Mainnet
VITE_GATEWAY_CONTRACT_ADDRESS=0x1BB7e074fAb1EBbadBf955E0f011D001bC329b0C

# Public Arc Mainnet RPC fallback (only needed outside Arc Studio)
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# ============================================================
# Operator Signer — KEEP SECRET, server-side only
# Signs InvoiceAuthorization EIP-712 structs.
# Generate a fresh key: openssl rand -hex 32
# NEVER use a wallet holding real funds as the signer.
# ============================================================
OPERATOR_SIGNER_PRIVATE_KEY=0xYOUR_OPERATOR_PRIVATE_KEY_HERE

# ============================================================
# Arc Studio RPC Proxy — Auto-provisioned in Arc Studio
# ============================================================
# RPC_PROXY_BASE_URL=
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=

# ============================================================
# Server
# ============================================================
CORS_ORIGINS=http://localhost:5173
REQUIRED_CONFIRMATIONS=2

# WalletConnect (optional — improves mobile wallet support)
# VITE_WALLETCONNECT_PROJECT_ID=your-project-id

# ============================================================
# Admin Portal — Separate password auth, no Supabase
# ============================================================
# Plain-text password for the /admin-login page.
# Use a strong random password: openssl rand -base64 24
ADMIN_PASSWORD=change-me-before-deploying

# Secret used to sign admin session JWTs (8h expiry).
# Generate: openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-before-deploying
