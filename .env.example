# ============================================================
# USDC-to-BDT Payment Gateway — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ============================================================
# Supabase — Required
# ============================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================================
# Blockchain — Arc Mainnet
# ============================================================
# Deployed gateway contract address (set after deploying)
VITE_GATEWAY_CONTRACT_ADDRESS=0x_REPLACE_WITH_DEPLOYED_CONTRACT_ADDRESS

# Public Arc Mainnet RPC (only needed outside Arc Studio)
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# ============================================================
# Operator Signer — KEEP SECRET, backend only
# Signs InvoiceAuthorization structs. Corresponds to operatorSigner in contract.
# Generate: openssl rand -hex 32
# NEVER use a wallet holding real funds as the signer.
# ============================================================
OPERATOR_SIGNER_PRIVATE_KEY=0x_REPLACE_WITH_32_BYTE_HEX_PRIVATE_KEY

# ============================================================
# Arc Studio RPC Proxy — Auto-provisioned, do not set manually
# ============================================================
# RPC_PROXY_BASE_URL=
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=

# ============================================================
# Server
# ============================================================
PORT=3001
CORS_ORIGINS=http://localhost:5173
REQUIRED_CONFIRMATIONS=2

# WalletConnect (optional)
# VITE_WALLETCONNECT_PROJECT_ID=your-project-id

# ============================================================
# Admin Portal — Separate from Supabase auth
# ============================================================
# Plain-text password for the /admin-login page.
# Use a strong random password: openssl rand -base64 24
ADMIN_PASSWORD=change-me-before-deploying

# Secret used to sign admin session JWTs. Generate with:
# openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-before-deploying

# Optional: override where the admin SQLite DB is stored (default: ./data/admin.db)
# ADMIN_DB_DIR=/var/data
